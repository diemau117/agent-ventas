; Dashboard Chatwoot (Puma :3001) — el "centro de control" del negocio.
; Arranca solo tras db+valkey; si esos fallan, Wants los intenta igual y
; Puma sale y reintenta (Restart=always). RAILS_ENV y credenciales salen de
; ~/chatwoot/.env (dotenv-rails lo carga al arrancar Rails).
; Frontend: requiere public/vite-dev pre-compilado (ver docs/ALTA_CLIENTE_CHATWOOT.md);
; sin él la primera petición HTML dispara un build inline y cuelga.

[Unit]
Description=Chatwoot dashboard (Puma 127.0.0.1:3001)
After=chatwoot-db.service chatwoot-valkey.service
Wants=chatwoot-db.service chatwoot-valkey.service

[Service]
Type=simple
WorkingDirectory=/home/diego/chatwoot
Environment=PATH=/home/diego/.local/bin:/home/diego/.local/ruby-3.4.4/bin:/home/diego/.local/share/node-v24/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/diego/chatwoot/bin/rails server -p 3001 -b 127.0.0.1
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
